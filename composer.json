{
  "name": "anibalealvarezs/frankfurter-api",
  "description": "Frankfurter API client for European Central Bank foreign exchange rates, extending api-client-skeleton.",
  "license": "MIT",
  "authors": [
    {
      "name": "Aníbal Álvarez",
      "email": "anibalealvarezs@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0",
    "anibalealvarezs/api-client-skeleton": "^1.0.0"
  },
  "autoload": {
    "psr-4": {
      "Anibalealvarezs\\FrankfurterApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9 || ^10",
    "phpstan/phpstan": "^1.10"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://satis.anibalalvarez.com/"
    }
  ]
}
